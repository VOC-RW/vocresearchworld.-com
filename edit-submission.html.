<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Edit or Revise Submission | VOC Research World</title>

<link rel="stylesheet" href="style.css">

<style>
.edit-wrap {
  max-width: 1000px;
  margin: 40px auto;
  padding: 0 18px;
}

.edit-card {
  background: #fff;
  border: 1px solid #dfe5ec;
  border-radius: 14px;
  padding: 24px;
  margin: 20px 0;
}

.edit-card .field {
  margin-bottom: 18px;
}

.edit-card input,
.edit-card select,
.edit-card textarea {
  width: 100%;
  box-sizing: border-box;
}

.edit-card textarea {
  min-height: 180px;
  resize: vertical;
}

.edit-card input[type="file"] {
  padding: 12px;
  border: 1px solid #dfe5ec;
  border-radius: 8px;
}

.edit-notice {
  background: #eef5ff;
  border-left: 4px solid #2865b4;
  border-radius: 8px;
  padding: 15px;
  margin-bottom: 20px;
}

.edit-notice.warning {
  background: #fff5df;
  border-left-color: #c18416;
}

.edit-result {
  margin-top: 18px;
  padding: 15px;
  border-radius: 9px;
  overflow-wrap: anywhere;
}

.edit-result.success {
  background: #effaf2;
  color: #176b36;
}

.edit-result.error {
  background: #fff0f0;
  color: #8b1b1b;
}

.edit-result[hidden] {
  display: none;
}

.edit-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.edit-actions button:disabled {
  opacity: .6;
  cursor: wait;
}

.edit-help {
  display: block;
  margin-top: 7px;
  color: #526173;
  font-size: .9rem;
}

.edit-meta {
  color: #526173;
  overflow-wrap: anywhere;
}

#editForm[hidden] {
  display: none;
}

@media (max-width: 600px) {
  .edit-wrap {
    margin: 24px auto;
    padding: 0 12px;
  }

  .edit-card {
    padding: 16px;
  }
}
</style>
</head>

<body>

<div id="header"></div>

<main class="edit-wrap">

  <p class="eyebrow">AUTHOR PORTAL</p>

  <h1 id="pageTitle">Edit or revise your manuscript</h1>

  <p>
    Update your manuscript information and resubmit it
    when you have completed your changes.
  </p>

  <section class="edit-card">

    <div id="pageStatus" class="edit-notice" role="status"
         aria-live="polite">
      Checking your account and submission...
    </div>

    <p id="submissionMeta" class="edit-meta" hidden></p>

    <div id="revisionNotice" class="edit-notice warning" hidden>
      <strong>Revision requested</strong>
      <p>
        The editorial team has requested changes to this manuscript.
        Make the necessary corrections before resubmitting.
      </p>
    </div>

    <form id="editForm" hidden>

      <div class="field">
        <label for="title">Manuscript title *</label>
        <input
          id="title"
          name="title"
          maxlength="300"
          required
        >
      </div>

      <div class="field">
        <label for="area">Research area *</label>
        <select id="area" name="area" required>
          <option value="">Loading research areas...</option>
        </select>
      </div>

      <div class="field">
        <label for="type">Submission type *</label>
        <select id="type" name="type" required>
          <option value="">Select submission type</option>
          <option value="Research Article">Research Article</option>
          <option value="Review Article">Review Article</option>
          <option value="Research Note">Research Note</option>
          <option value="Technical Note">Technical Note</option>
          <option value="Method">Method</option>
          <option value="Educational Resource">Educational Resource</option>
          <option value="Research Proposal">Research Proposal</option>
        </select>
      </div>

      <div class="field">
        <label for="keywords">Keywords</label>
        <input
          id="keywords"
          name="keywords"
          placeholder="e.g. Biochemistry, UV-Vis, data analysis"
        >
      </div>

      <div class="field">
        <label for="institution">Institution / affiliation</label>
        <input
          id="institution"
          name="institution"
          autocomplete="organization"
        >
      </div>

      <div class="field">
        <label for="abstract">Abstract / research summary *</label>
        <textarea
          id="abstract"
          name="abstract"
          required
          placeholder="Summarise the objectives, methods, findings and conclusions."
        ></textarea>
      </div>

      <div class="field">
        <label for="manuscript">Replacement manuscript file (optional)</label>
        <input
          id="manuscript"
          name="manuscript"
          type="file"
          accept=".pdf,.doc,.docx,.txt"
        >

        <small class="edit-help">
          Accepted formats: PDF, DOC, DOCX and TXT.
          Maximum file size: 10 MB.
          Leave this field empty to keep your existing manuscript file.
        </small>
      </div>

      <p id="currentFile" class="edit-meta"></p>

      <div class="edit-notice">
        <strong>Before resubmitting</strong>
        <p>
          Check all your changes carefully. Resubmission will return
          the manuscript to the editorial workflow.
        </p>
      </div>

      <div class="edit-actions">

        <button
          id="saveButton"
          class="btn primary"
          type="submit"
        >
          Resubmit Manuscript
        </button>

        <a class="btn secondary" href="dashboard.html">
          Cancel
        </a>

      </div>

    </form>

    <div
      id="editResult"
      class="edit-result"
      role="status"
      aria-live="polite"
      hidden
    ></div>

    <p>
      <a href="dashboard.html">Return to My Submissions</a>
    </p>

  </section>

</main>

<div id="footer"></div>

<script src="app.js"></script>

<script type="module">
import { supabase } from "./supabase-config.js";

/* =========================
   PAGE ELEMENTS
========================= */

const pageStatus = document.querySelector("#pageStatus");
const submissionMeta = document.querySelector("#submissionMeta");
const revisionNotice = document.querySelector("#revisionNotice");
const form = document.querySelector("#editForm");
const resultBox = document.querySelector("#editResult");
const saveButton = document.querySelector("#saveButton");
const currentFile = document.querySelector("#currentFile");

const titleInput = document.querySelector("#title");
const areaSelect = document.querySelector("#area");
const typeSelect = document.querySelector("#type");
const keywordsInput = document.querySelector("#keywords");
const institutionInput = document.querySelector("#institution");
const abstractInput = document.querySelector("#abstract");
const fileInput = document.querySelector("#manuscript");

const MAX_FILE_SIZE = 10 * 1024 * 1024;

const params = new URLSearchParams(window.location.search);
const submissionId = params.get("id");

let currentUser = null;
let submission = null;
let categories = [];
let isSaving = false;

/* =========================
   HELPERS
========================= */

function showPageStatus(message, isError = false) {
  pageStatus.textContent = message;
  pageStatus.style.background = isError ? "#fff0f0" : "#eef5ff";
  pageStatus.style.color = isError ? "#8b1b1b" : "#173b65";
  pageStatus.hidden = false;
}

function showResult(message, success = false) {
  resultBox.replaceChildren();

  const paragraph = document.createElement("p");
  paragraph.textContent = message;

  resultBox.appendChild(paragraph);
  resultBox.className =
    "edit-result " + (success ? "success" : "error");

  resultBox.hidden = false;

  resultBox.scrollIntoView({
    behavior: "smooth",
    block: "center"
  });
}

function hideResult() {
  resultBox.hidden = true;
  resultBox.replaceChildren();
}

function safeFileName(name) {
  return String(name || "manuscript")
    .normalize("NFKD")
    .replace(/[^a-zA-Z0-9._-]/g, "_")
    .replace(/_+/g, "_")
    .slice(-150) || "manuscript";
}

function canEdit(status) {
  return status === "draft" ||
         status === "revision_required";
}

function validateFile(file) {
  if (!file) return null;

  if (file.size === 0) {
    return "The selected file is empty. Choose another file.";
  }

  if (file.size > MAX_FILE_SIZE) {
    return "The file exceeds the 10 MB limit.";
  }

  if (!/\.(pdf|doc|docx|txt)$/i.test(file.name)) {
    return "Unsupported file type. Use PDF, DOC, DOCX or TXT.";
  }

  return null;
}

/*
  Do not display the private storage path as a public URL.
  This page deliberately does not generate a public link.
*/

function getFileLabel(path) {
  if (!path) return "No manuscript path is recorded.";

  const name = String(path).split("/").pop();

  return "Current manuscript file: " + (name || "Uploaded manuscript");
}

/* =========================
   LOAD CATEGORIES
========================= */

async function loadCategories(selectedId) {
  const { data, error } = await supabase
    .from("categories")
    .select("id,name,slug")
    .order("name");

  if (error) throw error;

  categories = data || [];

  areaSelect.replaceChildren();

  const placeholder = document.createElement("option");
  placeholder.value = "";
  placeholder.textContent = "Select a research area";
  areaSelect.appendChild(placeholder);

  categories.forEach(category => {
    const option = document.createElement("option");
    option.value = category.id;
    option.textContent = category.name;
    areaSelect.appendChild(option);
  });

  if (selectedId) {
    areaSelect.value = selectedId;
  }

  if (selectedId && areaSelect.value !== selectedId) {
    throw new Error(
      "The original research category is unavailable. Please contact the administrator."
    );
  }

  if (categories.length === 0) {
    throw new Error(
      "No research categories are configured."
    );
  }
}

/* =========================
   LOAD THE AUTHOR'S SUBMISSION
========================= */

async function initializePage() {
  try {
    if (!submissionId) {
      throw new Error(
        "No submission ID was provided. Open this page using the Edit or Revise button in your dashboard."
      );
    }

    const {
      data: { session },
      error: sessionError
    } = await supabase.auth.getSession();

    if (sessionError) throw sessionError;

    if (!session) {
      showPageStatus(
        "You must sign in first. Redirecting to account access..."
      );

      setTimeout(() => {
        window.location.href = "auth.html";
      }, 1200);

      return;
    }

    currentUser = session.user;

    /*
      RLS restricts access to submissions the signed-in user
      is allowed to view. Ownership is checked again here.
    */

    const { data: row, error } = await supabase
      .from("submissions")
      .select(`
        id,
        title,
        abstract,
        manuscript_url,
        category_id,
        submitted_by,
        status,
        submission_reference,
        submission_type,
        keywords,
        institution,
        created_at,
        submitted_at
      `)
      .eq("id", submissionId)
      .eq("submitted_by", currentUser.id)
      .maybeSingle();

    if (error) throw error;

    if (!row) {
      throw new Error(
        "This submission was not found in your account, or you do not have permission to access it."
      );
    }

    submission = row;

    if (!canEdit(row.status)) {
      form.hidden = true;

      throw new Error(
        "This manuscript cannot currently be edited. Only drafts and manuscripts marked revision required can be edited by authors."
      );
    }

    await loadCategories(row.category_id);

    titleInput.value = row.title || "";
    typeSelect.value = row.submission_type || "";
    keywordsInput.value = row.keywords || "";
    institutionInput.value = row.institution || "";
    abstractInput.value = row.abstract || "";

    currentFile.textContent = getFileLabel(row.manuscript_url);

    const reference =
      row.submission_reference || row.id;

    submissionMeta.textContent =
      "Reference: " + reference +
      " · Current status: " +
      String(row.status).replaceAll("_", " ");

    submissionMeta.hidden = false;

    if (row.status === "revision_required") {
      revisionNotice.hidden = false;
      document.querySelector("#pageTitle").textContent =
        "Revise your manuscript";
      saveButton.textContent = "Resubmit Revised Manuscript";
    } else {
      document.querySelector("#pageTitle").textContent =
        "Edit your draft";
      saveButton.textContent = "Submit Manuscript";
    }

    form.hidden = false;

    showPageStatus(
      "Submission loaded. You may now edit the permitted fields."
    );

  } catch (error) {
    console.error("Edit page initialization error:", error);

    showPageStatus(
      error.message || "Unable to load this submission.",
      true
    );
  }
}

/* =========================
   SAVE AND RESUBMIT
========================= */

form.addEventListener("submit", async event => {
  event.preventDefault();

  if (isSaving) return;

  hideResult();

  if (!currentUser || !submission) {
    showResult(
      "Your submission has not loaded correctly. Return to the dashboard and try again."
    );
    return;
  }

  if (!form.reportValidity()) return;

  /*
    Recheck the signed-in account before performing writes.
  */

  const {
    data: { user },
    error: userError
  } = await supabase.auth.getUser();

  if (userError || !user || user.id !== currentUser.id) {
    showResult(
      "Your session is no longer valid. Sign in again before resubmitting."
    );
    return;
  }

  const file = fileInput.files[0];
  const fileError = validateFile(file);

  if (fileError) {
    showResult(fileError);
    return;
  }

  const title = titleInput.value.trim();
  const abstract = abstractInput.value.trim();
  const categoryId = areaSelect.value;
  const submissionType = typeSelect.value;
  const keywords = keywordsInput.value.trim();
  const institution = institutionInput.value.trim();

  if (!title || !abstract || !categoryId || !submissionType) {
    showResult("Please complete all required fields.");
    return;
  }

  if (!categories.some(category => category.id === categoryId)) {
    showResult("Choose a valid research category.");
    return;
  }

  isSaving = true;
  saveButton.disabled = true;
  saveButton.textContent = "Saving revision...";

  let uploadedPath = null;

  try {
    /*
      Verify the row still belongs to this user and is still
      in a status that authors are permitted to edit.
    */

    const { data: latest, error: latestError } = await supabase
      .from("submissions")
      .select("id,submitted_by,status,submission_reference,manuscript_url")
      .eq("id", submission.id)
      .eq("submitted_by", currentUser.id)
      .maybeSingle();

    if (latestError) throw latestError;

    if (!latest) {
      throw new Error(
        "The submission could not be verified. No changes were saved."
      );
    }

    if (!canEdit(latest.status)) {
      throw new Error(
        "The submission status has changed. Authors may edit only drafts or requested revisions."
      );
    }

    let newManuscriptPath = latest.manuscript_url;

    /*
      Upload a replacement only if the author selected a new file.
      Preserve the existing private file otherwise.

      This uses the same user-ID-first folder convention as
      submit.html. Storage policies must permit this path.
    */

    if (file) {
      const reference =
        latest.submission_reference || latest.id;

      const filePath =
        currentUser.id + "/" +
        reference + "/revision-" +
        Date.now() + "-" +
        safeFileName(file.name);

      const { data: uploaded, error: uploadError } =
        await supabase.storage
          .from("manuscripts")
          .upload(filePath, file, {
            cacheControl: "3600",
            upsert: false
          });

      if (uploadError) throw uploadError;

      uploadedPath = uploaded.path;
      newManuscriptPath = uploaded.path;
    }

    /*
      Intentionally do not update protected fields:
      id, submitted_by, reviewer_notes, submitted_at,
      reviewed_at, created_at, updated_at,
      submission_reference and author_email.

      The database trigger handles updated_at and archives
      the previous submission fields in submission_revisions.
    */

    const patch = {
      title,
      abstract,
      category_id: categoryId,
      submission_type: submissionType,
      keywords: keywords || null,
      institution: institution || null,
      manuscript_url: newManuscriptPath,
      status: "submitted"
    };

    const { data: updated, error: updateError } = await supabase
      .from("submissions")
      .update(patch)
      .eq("id", submission.id)
      .eq("submitted_by", currentUser.id)
      .select("id,status,submission_reference")
      .maybeSingle();

    if (updateError) throw updateError;

    if (!updated) {
      throw new Error(
        "No submission was updated. Check your account permissions and submission status."
      );
    }

    submission.status = updated.status;
    submission.manuscript_url = newManuscriptPath;

    showResult(
      "Your manuscript has been resubmitted successfully. " +
      "Reference: " +
      (updated.submission_reference || updated.id) +
      ". You can track its status from your author dashboard.",
      true
    );

    /*
      Redirect only after the success message is shown.
    */

    saveButton.textContent = "Resubmitted";

    const dashboardLink = document.createElement("a");
    dashboardLink.href = "dashboard.html";
    dashboardLink.className = "btn primary";
    dashboardLink.textContent = "Return to My Submissions";

    resultBox.appendChild(document.createElement("br"));
    resultBox.appendChild(document.createElement("br"));
    resultBox.appendChild(dashboardLink);

    form.hidden = true;

  } catch (error) {
    console.error("Revision submission error:", error);

    /*
      If the database update failed after a new upload,
      try to remove only that newly uploaded file.
      Never remove the previously stored manuscript here.
    */

    if (uploadedPath) {
      const { error: cleanupError } = await supabase.storage
        .from("manuscripts")
        .remove([uploadedPath]);

      if (cleanupError) {
        console.error(
          "New-file cleanup failed:",
          cleanupError
        );
      }
    }

    let message = error.message ||
      "An unexpected error prevented resubmission.";

    if (/row-level security|permission denied|not allowed/i.test(message)) {
      message +=
        " Check the submissions UPDATE policy and the private manuscripts storage policy.";
    }

    showResult("Resubmission failed: " + message);

  } finally {
    isSaving = false;
    saveButton.disabled = false;

    if (form.hidden) {
      saveButton.textContent = "Resubmitted";
    } else if (submission?.status === "revision_required") {
      saveButton.textContent = "Resubmit Revised Manuscript";
    } else {
      saveButton.textContent = "Submit Manuscript";
    }
  }
});

/* Start the page. */

initializePage();

</script>

</body>
</html>
